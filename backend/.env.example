NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=

# Optional in development; required to provision the platform administrator. Password: 12-72 UTF-8 bytes.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Administrator

# Set strong, unique values in production; never commit production secrets.
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Configure either both certificate paths for direct TLS, or TRUST_PROXY
# with the exact proxy IP/CIDR or hop count for TLS termination.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
TRUST_PROXY=
